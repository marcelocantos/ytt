<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled YouTube ingest. Install with:

    cp scripts/playlist-ingest/launchd/com.marcelocantos.youtube-ingest.plist \
       ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.marcelocantos.youtube-ingest.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.marcelocantos.youtube-ingest.plist

  Design notes:
  - Pins ProgramArguments and YOUTUBE_INGEST_YTT_BIN to the Go ytt at
    ~/.local/bin/ytt (a symlink onto the checkout binary). Homebrew 0.11.0 is
    still the Python CLI and has no `build-index` subcommand: pointing the
    scheduler at /opt/homebrew/bin/ytt made every successful pass log
    `ytt: build-index: VideoUnavailable` and UNHEALTHY (2026-08-16 → 08-19).
    YOUTUBE_INGEST_CLAUDE_BIN is also an absolute path so launchd's minimal
    PATH cannot miss Claude Code.
  - YOUTUBE_CHANNELS_FILE is pinned to ~/.config/ytt/channels.yaml — OUTSIDE
    the install prefix. Pinning the binary above (2026-07-10) moved the script's
    idea of "beside me" into /opt/homebrew/Cellar/ytt/<version>/libexec/, which
    never contains the gitignored channels.yaml and is replaced wholesale on
    every `brew upgrade`. Channel discovery silently did nothing for 15 days as
    a result: the run reported "nothing to do" and exited 0 every night. Config
    must never be resolved from a package-managed directory.
  - Logs go to ~/.local/var/log/youtube-ingest/, NOT into ~/think, so scheduled
    runs don't produce auto-sync commits in the knowledge-base content tree.
  - Unhealthy runs report events to blurter, which owns the Slack credential,
    the delivery policy and the sinks. launchd records an exit code and tells
    nobody, so the exit code alone is not a monitoring strategy. blurter is
    pinned to an absolute path here for the same reason ytt and claude are:
    launchd's minimal PATH would not otherwise find it. The claude.ai Slack
    connector is deliberately not in this path — it is a Claude session
    capability and this job runs bash (measured 2026-07-26, a fresh `claude -p`
    had the Slack tools in 1 of 6 runs).
  - Paths are absolute and machine-specific (this is a personal scheduler);
    adjust the home path if installing elsewhere.
  - This is a stopgap until ytt ingest migrates onto crosshair (ytt T7),
    which is blocked on crosshair honoring scheduled triggers (crosshair T2).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marcelocantos.youtube-ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/marcelo/.local/bin/ytt</string>
        <string>ingest</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/marcelo/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>YOUTUBE_INGEST_PLAYLIST</key>
        <string>https://www.youtube.com/playlist?list=PLDVkHXSf0IIdu_-EN_z0lda-LE_J2VRk8</string>
        <key>YOUTUBE_INGEST_YTT_BIN</key>
        <string>/Users/marcelo/.local/bin/ytt</string>
        <key>YOUTUBE_INGEST_CLAUDE_BIN</key>
        <string>/Users/marcelo/.local/bin/claude</string>
        <key>YOUTUBE_CHANNELS_FILE</key>
        <string>/Users/marcelo/.config/ytt/channels.yaml</string>
        <key>YOUTUBE_INGEST_BLURTER_BIN</key>
        <string>/opt/homebrew/bin/blurter</string>
        <key>YOUTUBE_INGEST_LOG</key>
        <string>/Users/marcelo/.local/var/log/youtube-ingest/ingest.log</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/marcelo/.local/var/log/youtube-ingest/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marcelo/.local/var/log/youtube-ingest/launchd.log</string>
</dict>
</plist>
