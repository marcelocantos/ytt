<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled YouTube ingest. Install with:

    cp scripts/playlist-ingest/launchd/com.marcelocantos.youtube-ingest.plist \
       ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.marcelocantos.youtube-ingest.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.marcelocantos.youtube-ingest.plist

  Design notes:
  - Runs the INSTALLED binary (`/opt/homebrew/bin/ytt ingest`), never a working
    checkout, and pins YOUTUBE_INGEST_YTT_BIN plus YOUTUBE_INGEST_CLAUDE_BIN to
    absolute paths. launchd therefore cannot resolve a different build—or fail
    because its intentionally minimal PATH omits Claude Code's install directory.
  - Logs go to ~/.local/var/log/youtube-ingest/, NOT into ~/think, so scheduled
    runs don't produce auto-sync commits in the knowledge-base content tree.
  - Paths are absolute and machine-specific (this is a personal scheduler);
    adjust the home path if installing elsewhere.
  - This is a stopgap until ytt ingest migrates onto crosshair (ytt T7),
    which is blocked on crosshair honoring scheduled triggers (crosshair T2).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marcelocantos.youtube-ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ytt</string>
        <string>ingest</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/marcelo/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>YOUTUBE_INGEST_PLAYLIST</key>
        <string>https://www.youtube.com/playlist?list=PLDVkHXSf0IIdu_-EN_z0lda-LE_J2VRk8</string>
        <key>YOUTUBE_INGEST_YTT_BIN</key>
        <string>/opt/homebrew/bin/ytt</string>
        <key>YOUTUBE_INGEST_CLAUDE_BIN</key>
        <string>/Users/marcelo/.local/bin/claude</string>
        <key>YOUTUBE_INGEST_LOG</key>
        <string>/Users/marcelo/.local/var/log/youtube-ingest/ingest.log</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/marcelo/.local/var/log/youtube-ingest/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marcelo/.local/var/log/youtube-ingest/launchd.log</string>
</dict>
</plist>
