#!/usr/bin/env bash
# Mock notifier — records what ingest.sh tried to alert about, so tests can
# assert on the verdict without a network sink or a real banner.
#
# Appends one record per call to $NOTIFY_LOG:
#   <status> <subject>
#   > <body line>
#   > <body line>
set -euo pipefail

: "${NOTIFY_LOG:?notify-recorder needs NOTIFY_LOG}"
printf '%s %s\n' "${1:-}" "${2:-}" >> "$NOTIFY_LOG"
sed 's/^/> /' >> "$NOTIFY_LOG"
